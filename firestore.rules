rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /annotators/{document} {
      allow read, create, update: if true;
    }

    match /datapoints/{document} {
      allow read: if true;
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['reservedAnnotationSlots']) &&
        resource.data.reservedAnnotationSlots is int &&
        request.resource.data.reservedAnnotationSlots is int &&
        request.resource.data.reservedAnnotationSlots ==
          resource.data.reservedAnnotationSlots + 1 &&
        request.resource.data.reservedAnnotationSlots <= 3;
    }

    match /assignments/{document} {
      allow read, create, update: if true;
    }

    match /annotations/{document} {
      allow read, create: if true;
    }
  }
}
